# Browser security headers for every page and endpoint in phone_tracker.
<IfModule mod_headers.c>
    # Other websites may not show these pages inside a frame (clickjacking).
    Header always set X-Frame-Options "DENY"
    Header always set Content-Security-Policy "frame-ancestors 'none'"
    Header always set X-Content-Type-Options "nosniff"
    # Other sites receive only our origin (e.g. http://localhost/), never page paths.
    # OpenStreetMap's tile servers require this Referer; "same-origin" gets the maps blocked.
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Browsers keep their copies of pages, scripts and styles but must ask the server before
    # reusing one, so an update shows on the next visit. With no rule a browser guesses, and can
    # reuse an old page for days without asking (DEPLOYMENT.md, "Updating the system later").
    <FilesMatch "\.(html|js|css)$">
        Header always set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

# The database files (*.sql) and the API description (api/v1/openapi.yaml) are for the
# setup tools and developers, who read them from the project folder. Browsers get 403,
# so nobody can download the schema or the seed accounts' notes from the website.
<FilesMatch "\.(sql|ya?ml)$">
    Require all denied
</FilesMatch>
